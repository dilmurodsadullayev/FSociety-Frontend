
# ==========================================================
# FSOCIETY FRONTEND — ENVIRONMENT CONFIGURATION
# ==========================================================
#
# Project: FSociety-Frontend
# Framework: React (Create React App)
#
# Setup:
#   cp .env.example .env
#   npm ci
#   npm start
#
# IMPORTANT:
# - Never commit your actual .env file.
# - Never put private API keys or client secrets here.
# - Variables prefixed with REACT_APP_ are exposed
#   to the browser after the application is built.
# - Restart the development server after editing .env.
#
# ==========================================================


# ==========================================================
# 1. APPLICATION URLS
# ==========================================================

# React development server URL
REACT_APP_FRONTEND_URL=http://localhost:3000

# Django backend base URL
REACT_APP_BACKEND_URL=http://localhost:8000

# Django REST API base URL
REACT_APP_API_URL=http://localhost:8000/api

# Notification WebSocket URL
# Check your WebSocket client configuration when deploying.
REACT_APP_WS_URL=ws://localhost:8000/ws/notifications/


# ==========================================================
# 2. SOCIAL AUTHENTICATION
# ==========================================================

# Google OAuth public Client ID
# Configure in Google Cloud Console.
REACT_APP_GOOGLE_CLIENT_ID=

# GitHub OAuth public Client ID
# Configure in GitHub Developer Settings.
REACT_APP_GITHUB_CLIENT_ID=


# ==========================================================
# 3. APPLICATION BRANDING
# ==========================================================

# Short application name
REACT_APP_NAME=FSociety

# Full application name
REACT_APP_FULL_NAME=Fix Society

# Application description
REACT_APP_DESCRIPTION=FSociety - dasturchilar uchun muammolar, yechimlar va loyihalar hamjamiyati.

# Application version
REACT_APP_VERSION=0.1.0

# Release channel: development / staging / production
REACT_APP_RELEASE_CHANNEL=development

# Project creation year
REACT_APP_CREATED_YEAR=2025

# Optional logo URL or public asset path
# Leave empty to use the application's default logo.
REACT_APP_LOGO=


# ==========================================================
# 4. DEVELOPER INFORMATION
# ==========================================================

# Developer or brand name
REACT_APP_DEVELOPER_NAME=DimoDev

# Developer website/profile
REACT_APP_DEVELOPER_URL=https://github.com/dilmurodsadullayev


# ==========================================================
# 5. SOCIAL MEDIA LINKS
# ==========================================================

# Frontend source repository
REACT_APP_GITHUB_URL=https://github.com/dilmurodsadullayev/FSociety-Frontend

# Telegram channel/profile URL (optional)
REACT_APP_TELEGRAM_URL=

# LinkedIn profile URL (optional)
REACT_APP_LINKEDIN_URL=


# ==========================================================
# END OF FSOCIETY FRONTEND CONFIGURATION
# ==========================================================
